generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model User {
  id                     String           @id @default(cuid())
  linkedinId             String?          @unique
  name                   String?
  email                  String?          @unique
  emailVerified          DateTime?
  role                   String           @default("user")
  image                  String?
  headline               String?
  summary                String?
  skills                 String?
  industry               String?
  profileUrl             String?
  tonePrefs              String?
  onboardingCompleted    Boolean          @default(false)
  contentGoals           String?
  positioning            String?
  contentStyles          String?
  targetAudience         String?
  humanMode              Boolean          @default(true)
  postingSchedule        String?
  postSignature          String?
  timezone               String           @default("Asia/Kolkata")
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt
  companyProfilesEnabled Boolean          @default(false)
  accounts               Account[]
  CompanyProfile         CompanyProfile[]
  contentPlans           ContentPlan[]
  newsletters            Newsletter[]
  sessions               Session[]
  subscription           Subscription?
}

model Subscription {
  id                      String    @id @default(cuid())
  userId                  String    @unique
  razorpayCustomerId      String?   @unique
  razorpaySubscriptionId  String?   @unique
  razorpayPlanId          String?
  currency                String    @default("INR")
  status                  String    @default("trialing")
  trialEnd                DateTime?
  currentPeriodEnd        DateTime?
  postsGeneratedThisCycle Int       @default(0)
  cyclePostsResetAt       DateTime?
  trialRemindersSent      String    @default("")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  user                    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ContentPlan {
  id               String          @id @default(cuid())
  userId           String
  weekStart        DateTime
  strategy         String
  createdAt        DateTime        @default(now())
  companyProfileId String?
  CompanyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  posts            Post[]

  @@unique([userId, companyProfileId, weekStart])
  @@index([companyProfileId])
}

model Post {
  id                  String      @id @default(cuid())
  planId              String
  title               String
  body                String
  imageUrl            String?
  images              String?
  imagePrompt         String?
  imageGenCount       Int         @default(0)
  hashtags            String?
  postType            String
  scheduledAt         DateTime?
  status              String      @default("draft")
  weekNumber          Int         @default(1)
  humanModeOverride   Boolean?
  postedToLinkedIn    Boolean     @default(false)
  linkedinPostId      String?
  postError           String?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  linkedinLikes       Int?
  linkedinComments    Int?
  linkedinShares      Int?
  linkedinImpressions Int?
  engagementSyncedAt  DateTime?
  customSignature     String?
  plan                ContentPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([status])
  @@index([scheduledAt])
}

model Newsletter {
  id               String          @id @default(cuid())
  userId           String
  title            String
  subject          String
  body             String
  pillars          String?
  scheduledAt      DateTime?
  status           String          @default("draft")
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  companyProfileId String?
  CompanyProfile   CompanyProfile? @relation(fields: [companyProfileId], references: [id], onDelete: Cascade)
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([scheduledAt])
  @@index([companyProfileId])
}

model CompanyProfile {
  id                  String        @id
  userId              String
  name                String
  tagline             String?
  about               String?
  industry            String?
  website             String?
  logoUrl             String?
  tonePrefs           String?
  positioning         String?
  contentGoals        String?
  contentStyles       String?
  targetAudience      String?
  humanMode           Boolean       @default(false)
  postingSchedule     String?
  postSignature       String?
  timezone            String        @default("Asia/Kolkata")
  linkedinOrgId       String?
  onboardingCompleted Boolean       @default(false)
  createdAt           DateTime      @default(now())
  updatedAt           DateTime
  User                User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  ContentPlan         ContentPlan[]
  Newsletter          Newsletter[]

  @@index([userId])
}
